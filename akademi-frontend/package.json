{
  "name": "akademi-frontend",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "index.ts",
  "scripts": {
    "start": "cross-env EXPO_NO_REDIRECT_PAGE=1 expo start --go --lan",
    "start:go": "cross-env EXPO_NO_REDIRECT_PAGE=1 expo start --go --lan --clear",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --pretty false",
    "ci:check": "npm run typecheck",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/material-top-tabs": "^7.4.23",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/stack": "^7.8.6",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "axios": "^1.13.6",
    "expo": "^57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-speech-recognition": "^56.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.72.0",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.61.0",
    "@types/react": "~19.2.4",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
