DATABASE_URL=postgresql://user:password@localhost:5432/akademi
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano
# Adaptive tutor V2 rollout switch. Set false for an immediate runtime rollback to the legacy tutor.
ADAPTIVE_TUTOR_V2_ENABLED=true
# Adaptive tutor routing. Leave the model overrides blank to use OPENAI_MODEL for every tier.
# Set a stronger model in production for complex tutoring and/or verification without paying
# that cost for simple definitions, routing, and straightforward questions.
OPENAI_TUTOR_COMPLEX_MODEL=
OPENAI_TUTOR_VERIFIER_MODEL=
OPENAI_TUTOR_PLANNER_MODEL=
# Must match the model family used to create stored material embeddings when possible.
# If vector dimensions do not match, retrieval safely falls back to lexical + LLM reranking.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
# Google Custom Search JSON API (image search mode) — sources diagram images for Akademi
# Generated Textbooks. Create a Programmable Search Engine at https://programmablesearchengine.google.com/
# with "Image search" and "Search the entire web" enabled, then enable the "Custom Search API"
# in Google Cloud Console and generate an API key for GOOGLE_CSE_API_KEY. GOOGLE_CSE_ID is the
# search engine's "cx" value from the Programmable Search Engine control panel. Diagram sourcing
# is best-effort — leaving these unset means sections that need a diagram just publish without
# one, nothing breaks.
GOOGLE_CSE_API_KEY=your_google_custom_search_api_key_here
GOOGLE_CSE_ID=your_google_custom_search_engine_id_here
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY=your_r2_access_key_here
R2_SECRET_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=akademi-files
R2_PUBLIC_URL=your_r2_public_url_here
RESEND_API_KEY=your_resend_api_key_here
TYPESENSE_HOST=localhost
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your_typesense_api_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here
KORA_SECRET_KEY=your_kora_live_secret_key_here
KORA_PUBLIC_KEY=your_kora_live_public_key_here
# Automatically prepare this many CBT questions for every extracted material.
MATERIAL_QUESTION_BANK_TARGET=30
# Number of old/incomplete material banks reconciled during each recovery sweep.
QUESTION_BANK_RECOVERY_BATCH_SIZE=20
QUESTION_BANK_LOW_WATER=20
QUESTION_BANK_CRITICAL_WATER=10
QUESTION_BANK_REFILL_BATCH=10
QUESTION_BANK_MAX_SIZE=300
QUESTION_BANK_REFILL_COOLDOWN_MS=60000
QUESTION_BANK_MAX_BATCHES_PER_HOUR=6
PUBLIC_API_URL=https://akademi-app-1.onrender.com
# Keep regulated Koin money movement disabled until the payment provider approves the use case.
# Enable only after Kora has approved the stored-value Koin use case and the webhook is configured.
KOIN_PURCHASES_ENABLED=false
KOIN_WITHDRAWALS_ENABLED=false
SENTRY_DSN=your_sentry_dsn_here
PORT=3000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Emergency testing override only. Keep false in production unless deliberately testing access.
UNLOCK_ALL_FEATURES=false
SERVICE_TYPE=api
